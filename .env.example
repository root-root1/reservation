# Copy to .env and fill in. .env is gitignored and blocked from Claude.

# --- compose: postgres container --------------------------------------------
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=

# --- app -> database --------------------------------------------------------
# Deliberately NOT named SPRING_DATASOURCE_*: Spring's relaxed binding would
# map that env var onto the same property the placeholder reads, which
# self-references and fails to resolve.
# Host is localhost while the app runs from the IDE; becomes "db" in Step 7.
DB_URL=jdbc:postgresql://localhost:5432/db
DB_USER=user
DB_PASSWORD=

# Must stay under postgres max_connections (100 locally, far lower on free tiers).
DB_POOL_SIZE=20

# --- app --------------------------------------------------------------------
JWT_SECRET=
APP_RESERVATION_PER_USER_LIMIT=4
APP_RESERVATION_HOLD_TTL_SECONDS=120
TOMCAT_MAX_THREADS=200

# --- unused until the Redis decision is made (see README) -------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
